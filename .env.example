# 复制为 .env 后填写当前环境的真实配置，并执行 chmod 600 .env。
# 此文件只提供变量名和示例值，不含线上凭据。
DB_NAME=replace_with_database_name
DB_USER=replace_with_database_user
DB_PASSWORD=replace_with_database_password
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_PORT=6366
BACKEND_PORT=6365
# Go images are built from this checkout by default; --no-build uses loaded images.
PANEL_IMAGE=flux-panel-go:local
FRONTEND_IMAGE=flux-panel-frontend:local
MYSQL_IMAGE=mysql:8.2
MYSQL_VOLUME_NAME=flux_panel_mysql_data
PANEL_BIND=127.0.0.1
TZ=Asia/Shanghai
# Set all three from the same verified node release before generating installers.
NODE_RELEASE_BASE_URL=
NODE_RELEASE_MANIFEST_SHA256=
NODE_RELEASE_INSTALLER_SHA256=
